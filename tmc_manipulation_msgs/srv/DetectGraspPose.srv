# The target point
geometry_msgs/PointStamped target_point

# Input image
sensor_msgs/Image color_image
sensor_msgs/Image depth_image
sensor_msgs/CameraInfo color_camera_info
sensor_msgs/CameraInfo depth_camera_info

---
# The returned solution
tmc_task_msgs/PinchGraspPattern[] grasp_patterns

# Object to be grasped. Pose and it's shapes
# frame_id of object_pose is equal to request.points
geometry_msgs/PoseStamped object_pose
geometry_msgs/Pose[] shape_poses
tmc_geometric_shapes_msgs/Shape[] shapes